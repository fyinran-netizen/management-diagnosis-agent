OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen3:8b

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=management-diagnosis-qwen

USE_PRIVATE_KNOWLEDGE=false

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_HOME=D:\management_diagnosis_agent\.hf_cache
SENTENCE_TRANSFORMERS_HOME=D:\management_diagnosis_agent\.hf_cache
EMBEDDING_LOCAL_FILES_ONLY=true
TORCH_HOME=D:\management_diagnosis_agent\.torch_cache

PROJECT_RUNTIME_DIR=D:\management_diagnosis_agent\.runtime
TEMP=D:\management_diagnosis_agent\.runtime\tmp
TMP=D:\management_diagnosis_agent\.runtime\tmp
TMPDIR=D:\management_diagnosis_agent\.runtime\tmp
PIP_CACHE_DIR=D:\management_diagnosis_agent\.pip_cache
XDG_CACHE_HOME=D:\management_diagnosis_agent\.cache
UV_CACHE_DIR=D:\management_diagnosis_agent\.uv_cache
UV_PYTHON_INSTALL_DIR=D:\management_diagnosis_agent\.uv_python
UV_PROJECT_ENVIRONMENT=D:\management_diagnosis_agent\.venv
